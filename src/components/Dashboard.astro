---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import { monthly, zones } from '../data/dashboard';
import { t, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;

// ── KPIs calculados desde los datos (nada escrito a mano)
const fmt = new Intl.NumberFormat(lang === 'es' ? 'es-PE' : 'en-US');
const collected = monthly.reduce((a, m) => a + (m.collected ?? 0), 0);
const goal = monthly.reduce((a, m) => a + m.goal, 0);
const progress = Math.round((collected / goal) * 100);
const arrears = (zones.reduce((a, z) => a + z.arrears, 0) / zones.length).toFixed(1);
const kpis = [
  { label: t(ui.dashCollected, lang), value: `S/ ${fmt.format(collected * 1000)}` },
  { label: t(ui.dashGoal, lang), value: `S/ ${fmt.format(goal * 1000)}` },
  { label: t(ui.dashProgress, lang), value: `${progress}%` },
  { label: t(ui.dashArrears, lang), value: `${arrears}%` },
];

// ── Geometría del gráfico de barras (SVG)
const W = 640, H = 260, padL = 36, padR = 8, padT = 14, padB = 28;
const maxY = Math.ceil(Math.max(...monthly.map((m) => Math.max(m.goal, m.collected ?? 0))) / 50) * 50;
const innerW = W - padL - padR, innerH = H - padT - padB;
const step = innerW / monthly.length;
const barW = step * 0.56;
const y = (v: number) => padT + innerH - (v / maxY) * innerH;
const ticks = [0, 1, 2, 3, 4].map((i) => Math.round((maxY / 4) * i));
const goalPath = monthly.map((m, i) => `${i === 0 ? 'M' : 'L'}${padL + step * i + step / 2},${y(m.goal)}`).join(' ');
---
<Card id="dashboard" label={t(ui.dash, lang)}>
  <div class="mb-5 flex items-start gap-2.5 rounded-xl border border-accent-line bg-accent-soft px-3.5 py-3 text-sm text-accent-strong">
    <Icon name="lucide:flask-conical" class="mt-0.5 size-4 shrink-0" />
    <p>{t(ui.dashIntro, lang)}</p>
  </div>

  <dl class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {kpis.map((k) => (
      <div class="rounded-2xl border border-line bg-stone-50/80 p-4">
        <dt class="text-xs text-muted">{k.label}</dt>
        <dd class="mt-1 text-xl font-bold tracking-tight">{k.value}</dd>
      </div>
    ))}
  </dl>

  <div class="grid gap-5 lg:grid-cols-5">
    <figure class="rounded-2xl border border-line bg-stone-50/80 p-4 lg:col-span-3" data-dash>
      <figcaption class="mb-3 text-sm font-semibold">{t(ui.dashMonthly, lang)}</figcaption>
      <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-label={t(ui.dashMonthly, lang)}>
        {ticks.map((tk) => (
          <g>
            <line x1={padL} x2={W - padR} y1={y(tk)} y2={y(tk)} stroke="var(--color-line)" stroke-width="1" />
            <text x={padL - 6} y={y(tk) + 3.5} text-anchor="end" font-size="10" fill="var(--color-faint)">{tk}</text>
          </g>
        ))}
        {monthly.map((m, i) => {
          const x = padL + step * i + (step - barW) / 2;
          return (
            <g>
              {m.collected !== null && (
                <rect class="bar" tabindex="0" x={x} y={y(m.collected)} width={barW} height={padT + innerH - y(m.collected)} rx="3" fill="var(--color-accent)"
                  data-detail={`${t(m.label, lang)}: S/ ${fmt.format(m.collected * 1000)} · ${t(ui.dashLegendGoal, lang)} S/ ${fmt.format(m.goal * 1000)} (${Math.round((m.collected / m.goal) * 100)}%)`}>
                  <title>{`${t(m.label, lang)}: S/ ${fmt.format(m.collected * 1000)}`}</title>
                </rect>
              )}
              <text x={padL + step * i + step / 2} y={H - 9} text-anchor="middle" font-size="10" fill="var(--color-faint)">{t(m.label, lang)}</text>
            </g>
          );
        })}
        <path d={goalPath} fill="none" stroke="var(--color-ink)" stroke-width="1.75" stroke-dasharray="5 4" />
      </svg>
      <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
        <span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 rounded-sm bg-accent"></span>{t(ui.dashLegendCollected, lang)}</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-4 border-t-2 border-dashed border-ink"></span>{t(ui.dashLegendGoal, lang)}</span>
      </div>
      <p class="mt-2 min-h-5 text-xs text-muted" data-readout aria-live="polite">{t(ui.dashHint, lang)}</p>
    </figure>

    <figure class="rounded-2xl border border-line bg-stone-50/80 p-4 lg:col-span-2">
      <figcaption class="mb-4 text-sm font-semibold">{t(ui.dashZones, lang)}</figcaption>
      <ul class="space-y-3">
        {zones.map((z) => (
          <li>
            <div class="mb-1 flex items-center justify-between text-xs">
              <span class="font-medium">{t(z.name, lang)}</span>
              <span class="text-muted">{z.arrears}%</span>
            </div>
            <div class="h-2.5 overflow-hidden rounded-full bg-stone-200" role="img" aria-label={`${t(z.name, lang)}: ${z.arrears}%`}>
              <div class="h-full rounded-full bg-accent" style={`width:${z.arrears}%`}></div>
            </div>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</Card>

<style>
  .bar { transition: opacity .15s; outline: none; }
  [data-dash]:has(.bar:hover) .bar:not(:hover),
  [data-dash]:has(.bar:focus) .bar:not(:focus) { opacity: .45; }
  .bar:focus-visible { stroke: var(--color-ink); stroke-width: 2; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dash]').forEach((fig) => {
    const out = fig.querySelector<HTMLElement>('[data-readout]');
    const hint = out?.textContent ?? '';
    fig.querySelectorAll<SVGElement>('.bar').forEach((bar) => {
      const show = () => { if (out) out.textContent = bar.dataset.detail ?? hint; };
      bar.addEventListener('mouseenter', show);
      bar.addEventListener('focus', show);
      bar.addEventListener('click', show);
      bar.addEventListener('mouseleave', () => { if (out) out.textContent = hint; });
    });
  });
</script>
