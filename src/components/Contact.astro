---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import { site } from '../config';
import { profile } from '../data/profile';
import { t, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const field = 'w-full rounded-xl border border-line bg-stone-50 px-4 py-3 text-sm outline-none transition placeholder:text-stone-400 focus:border-ink focus:bg-white';
const label = 'mb-1.5 block text-sm font-semibold';
const subject = lang === 'es' ? 'Contacto desde tu portafolio' : 'Contact from your portfolio';
---
<Card id="contact" title={t(ui.contactTitle, lang)} note={t(profile.responseTime, lang)}>
  <form
    id="contact-form"
    class="space-y-4"
    data-endpoint={site.formEndpoint}
    data-mailto={site.email}
    data-wa={site.whatsapp}
    data-subject={subject}
    data-sending={t(ui.sending, lang)}
    data-ok={t(ui.sentOk, lang)}
    data-err={t(ui.sentErr, lang)}
  >
    <div class="grid gap-4 sm:grid-cols-2">
      <div><label class={label} for="name">{t(ui.formName, lang)}</label><input class={field} id="name" name="name" required autocomplete="name" placeholder={t(ui.formNamePh, lang)} /></div>
      <div><label class={label} for="email">{t(ui.formEmail, lang)}</label><input class={field} id="email" name="email" type="email" required autocomplete="email" placeholder={t(ui.formEmailPh, lang)} /></div>
    </div>
    <div><label class={label} for="message">{t(ui.formMessage, lang)}</label><textarea class={field} id="message" name="message" rows="4" required placeholder={t(ui.formMessagePh, lang)}></textarea></div>
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <div class="flex flex-col-reverse items-stretch justify-between gap-4 border-t border-stone-100 pt-4 sm:flex-row sm:items-center">
      <p class="text-sm text-muted" data-status role="status" aria-live="polite">{site.email} · {t(profile.location, lang)}</p>
      <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-ink/85 active:scale-[0.98] disabled:opacity-60">
        <Icon name="lucide:send" class="size-4" /> <span data-label>{t(ui.send, lang)}</span>
      </button>
    </div>
  </form>
</Card>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const d = form.dataset;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data._gotcha) return; // anti-spam

      if (!d.endpoint) {
        // Sin backend: abre WhatsApp con el mensaje ya escrito.
        const body = `${data.message}\n\n${data.name} · ${data.email}`;
        location.href = `https://wa.me/${d.wa}?text=${encodeURIComponent(body)}`;
        return;
      }

      const original = label.textContent;
      btn.disabled = true;
      label.textContent = d.sending ?? '';
      try {
        const res = await fetch(d.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        status.textContent = d.ok ?? '';
        form.reset();
      } catch {
        status.textContent = d.err ?? '';
      } finally {
        btn.disabled = false;
        label.textContent = original;
      }
    });
  }
</script>
