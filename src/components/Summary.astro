---
import Card from './Card.astro';
import { profile } from '../data/profile';
import { t, rich, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Card title={t(ui.summary, lang)} note={t(profile.focus, lang)}>
  <p class="mb-3 text-xl font-semibold leading-snug tracking-tight text-ink sm:text-2xl">{t(profile.headline, lang)}</p>
  <p class="text-sm leading-relaxed text-muted sm:text-[15px]" set:html={rich(t(profile.summary, lang))} />
  <p class="mt-2 text-sm font-medium text-ink">{t(profile.availability, lang)}</p>
  <p class="mt-4 text-sm">
    <a href="#projects" class="font-medium text-ink underline decoration-line underline-offset-4 transition hover:decoration-ink">
      {t(ui.summaryLink, lang)}
    </a>
  </p>
</Card>
