---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import { credentials } from '../data/credentials';
import { profile } from '../data/profile';
import { t, withBase, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Card title={t(ui.credentials, lang)} note={t(ui.credentialsNote, lang)} class="flex flex-col">
  <ul class="space-y-3">
    {credentials.map((c) => {
      const Tag = c.url ? 'a' : 'div';
      return (
        <li>
          <Tag
            {...(c.url ? { href: withBase(c.url), target: '_blank', rel: 'noopener noreferrer', title: t(ui.viewDocument, lang) } : {})}
            class:list={[
              'flex items-center justify-between gap-3 rounded-2xl border border-line bg-stone-50 p-3.5',
              c.url && 'transition hover:border-stone-300 hover:bg-white hover:shadow-sm',
            ]}
          >
            <div class="flex min-w-0 items-center gap-3">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl border border-line bg-stone-100 text-[10px] font-bold">{c.badge}</span>
              <div class="min-w-0">
                <p class="text-sm font-bold leading-snug">{t(c.title, lang)}</p>
                <p class="text-xs text-muted">{c.issuer}</p>
              </div>
            </div>
            {c.verified && (
              <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-md border border-accent-line bg-accent-soft px-2 py-0.5 text-[11px] font-semibold text-accent-strong">
                <Icon name="lucide:badge-check" class="size-3.5" />{t(ui.verified, lang)}
              </span>
            )}
            {!c.verified && c.url && (
              <Icon name="lucide:file-text" class="size-4 shrink-0 text-faint" />
            )}
          </Tag>
        </li>
      );
    })}
  </ul>
  <p class="mt-auto border-t border-stone-100 pt-4 text-sm text-muted">
    <span class="font-semibold text-ink">{t(ui.languages, lang)}:</span>{' '}
    {profile.languages.map((l, i) => <>{i > 0 && ' · '}{t(l.name, lang)} ({t(l.level, lang)})</>)}
  </p>
</Card>
