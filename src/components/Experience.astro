---
import { Icon } from 'astro-icon/components';
import Card from './Card.astro';
import Chip from './Chip.astro';
import { experience } from '../data/experience';
import { t, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Card title={t(ui.experience, lang)} note={t(ui.experienceNote, lang)}>
  <ol class="space-y-4">
    {experience.map((job) => (
      <li class="flex flex-col gap-2.5 rounded-2xl border border-line bg-stone-50/70 p-4 sm:p-5">
        <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
          <div>
            <h3 class="text-sm font-bold sm:text-[15px]">{t(job.role, lang)}</h3>
            <p class="mt-0.5 flex items-center gap-1.5 text-sm text-muted"><Icon name="lucide:building-2" class="size-3.5 text-stone-400" />{job.company}</p>
          </div>
          <span class="inline-flex items-center gap-1.5 self-start whitespace-nowrap rounded-md border border-line bg-white px-2.5 py-1 text-xs font-semibold text-stone-700">
            <Icon name="lucide:calendar" class="size-3.5 text-stone-400" />{job.from} – {job.to ?? t(ui.present, lang)}
          </span>
        </div>
        <p class="text-sm leading-relaxed text-muted">{t(job.description, lang)}</p>
        <div class="flex flex-wrap gap-1.5 pt-1">{job.tags.map((tag) => <Chip>{tag}</Chip>)}</div>
      </li>
    ))}
  </ol>
</Card>
