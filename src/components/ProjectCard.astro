---
import { Icon } from 'astro-icon/components';
import Chip from './Chip.astro';
import type { Project } from '../data/projects';
import { t, withBase, type Lang } from '../i18n/utils';
import { ui } from '../i18n/ui';
interface Props { project: Project; lang: Lang }
const { project: p, lang } = Astro.props;
const last = p.flow.steps.length - 1;
const wip = p.status === 'wip';
---
<article data-status={wip ? 'wip' : 'done'} class:list={['group relative flex flex-col rounded-2xl border bg-stone-50/80 p-4 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:bg-white hover:shadow-lg sm:p-5', wip ? 'border-dashed border-accent-line hover:border-accent' : 'border-line hover:border-stone-300']}>
  {p.cover
    ? <img src={withBase(p.cover)} alt={t(p.title, lang)} width="1200" height="675" loading="lazy" class="mb-4 aspect-video w-full rounded-xl border border-line object-cover" />
    : (
      <div class="mb-4 flex aspect-video w-full flex-col rounded-xl border border-[#27272a] bg-[#18181b] p-4 text-[#d4d4d8] dark:bg-[#0a0a0c]" aria-hidden="true">
        <div class="flex items-center justify-between gap-2 font-mono text-[11px]">
          <span class="truncate text-emerald-400">{p.flow.label}</span>
          {p.flow.badge && <span class="whitespace-nowrap rounded border border-emerald-800 bg-emerald-950 px-1.5 py-0.5 text-[10px] text-emerald-400">{p.flow.badge}</span>}
        </div>
        <div class="my-auto flex flex-wrap items-center gap-x-1 gap-y-2.5 font-mono text-[11px]">
          {p.flow.steps.map((s, i) => (
            <span class="inline-flex items-center gap-1">
              {i > 0 && <Icon name="lucide:arrow-right" class="size-3 shrink-0 text-emerald-500" />}
              <span class:list={['whitespace-nowrap rounded px-2 py-1', i === last ? 'border border-emerald-700/50 bg-emerald-900/60 text-emerald-300' : 'bg-[#27272a]']}>{s}</span>
            </span>
          ))}
        </div>
      </div>
    )}

  <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <span class="text-[11px] font-bold uppercase tracking-wide text-faint">{t(p.category, lang)}</span>
    {wip && <span class="whitespace-nowrap rounded-full border border-accent-line bg-accent-soft px-2 py-0.5 text-[11px] font-semibold text-accent-strong">{t(ui.wip, lang)}</span>}
    {p.metric && <span class="whitespace-nowrap rounded-full border border-accent-line bg-accent-soft px-2 py-0.5 text-[11px] font-semibold text-accent-strong">{t(p.metric, lang)}</span>}
  </div>
  <h3 class="mb-1.5 text-[15px] font-bold leading-snug">{t(p.title, lang)}</h3>
  {p.notaDemo && <p class="mb-2 text-xs italic text-faint">{t(p.notaDemo, lang)}</p>}
  { (p.problema || p.queHice || p.decisiones || p.resultado)
    ? (
      <div class="mb-4 space-y-3 text-sm leading-relaxed">
        {p.problema && (
          <div>
            <p class="mb-0.5 text-[11px] font-bold uppercase tracking-wide text-faint">{lang === 'es' ? 'Problema' : 'Problem'}</p>
            <p class="text-muted">{t(p.problema, lang)}</p>
          </div>
        )}
        {p.queHice && (
          <div>
            <p class="mb-0.5 text-[11px] font-bold uppercase tracking-wide text-faint">{lang === 'es' ? 'Qué hice' : 'What I did'}</p>
            <p class="text-muted">{t(p.queHice, lang)}</p>
          </div>
        )}
        {p.decisiones && p.decisiones.length > 0 && (
          <div>
            <p class="mb-0.5 text-[11px] font-bold uppercase tracking-wide text-faint">{lang === 'es' ? 'Decisiones' : 'Decisions'}</p>
            <ul class="list-disc space-y-1 pl-4 text-muted">
              {p.decisiones.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        )}
        {p.resultado && (
          <div>
            <p class="mb-0.5 text-[11px] font-bold uppercase tracking-wide text-faint">{lang === 'es' ? 'Resultado' : 'Result'}</p>
            <p class="text-muted">{t(p.resultado, lang)}</p>
          </div>
        )}
      </div>
    )
    : <p class="mb-4 text-sm leading-relaxed text-muted">{t(p.description, lang)}</p>
  }

  <div class="mt-auto">
    <div class="mb-4 flex flex-wrap gap-1.5 border-t border-line pt-3">{p.tags.map((tag) => <Chip>{tag}</Chip>)}</div>
    {(p.demo || p.demo2 || p.repo) && (
      <div class="flex flex-wrap items-center gap-2">
        {p.demo && (
          <a href={p.demo} target="_blank" rel="noopener noreferrer" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-lg bg-ink px-3 py-2 text-xs font-semibold text-white transition hover:bg-ink/85">
            <Icon name="lucide:external-link" class="size-3.5" /> {p.demo2 ? (lang === 'es' ? 'Demo 2025' : 'Demo 2025') : t(ui.demo, lang)}
          </a>
        )}
        {p.demo2 && (
          <a href={p.demo2} target="_blank" rel="noopener noreferrer" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-line bg-stone-100 px-3 py-2 text-xs font-semibold transition hover:bg-stone-200">
            <Icon name="lucide:external-link" class="size-3.5" /> {lang === 'es' ? 'Demo 2024' : 'Demo 2024'}
          </a>
        )}
        {p.repo && (
          <a href={p.repo} target="_blank" rel="noopener noreferrer" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-line bg-stone-100 px-3 py-2 text-xs font-semibold transition hover:bg-stone-200">
            <Icon name="simple-icons:github" class="size-3.5" /> {t(ui.code, lang)}
          </a>
        )}
        {!p.demo && !p.demo2 && p.repo && (
          <a href={p.repo} target="_blank" rel="noopener noreferrer" class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-lg bg-ink px-3 py-2 text-xs font-semibold text-white transition hover:bg-ink/85">
            <Icon name="simple-icons:github" class="size-3.5" /> {t(ui.code, lang)}
          </a>
        )}
      </div>
    )}
  </div>
</article>
